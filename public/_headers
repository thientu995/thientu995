# Cloudflare Pages native headers file (served from the build output).
# https://developers.cloudflare.com/pages/configuration/headers/

# Security baseline on every response.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Astro fingerprints everything under /_astro - cache it forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Non-hashed assets change rarely; one day is a safe default.
/assets/*
  Cache-Control: public, max-age=86400
