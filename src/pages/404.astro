---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data';
---

<BaseLayout title={`404 — ${site.title}`} description="Page not found. Head back to the profile home page.">
    <section class="section">
        <div class="container nf">
            <span class="eyebrow">404</span>
            <h1>Page <span class="grad">not found</span></h1>
            <p>The page you're looking for doesn't exist or has moved.</p>

            <div class="term card" aria-hidden="true">
                <span><span class="prompt">$</span> curl -I {site.url}<span class="cursor"></span></span>
                <span class="resp">HTTP/2 404</span>
            </div>

            <a href="/" class="btn btn-primary">
                <Icon name="arrow-right" size={16} />
                Back to profile
            </a>
        </div>
    </section>
</BaseLayout>

<style lang="scss">
    @use '../styles/tokens';

    .nf {
        max-width: 640px;
        padding: calc(var(--nav-h) + 60px) 0 80px;
        text-align: center;

        h1 {
            font-size: clamp(40px, 6vw, 64px);
            margin: 16px 0 12px;

            .grad {
                background: var(--grad-text);
                background-clip: text;
                -webkit-background-clip: text;
                color: transparent;
            }
        }

        p {
            color: var(--muted);
            margin-bottom: 26px;
        }
    }

    .term {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 20px 24px;
        margin: 0 auto 30px;
        max-width: 420px;
        text-align: left;
        font: 400 13.5px/1.7 var(--font-mono);

        .prompt {
            color: var(--green);
            margin-right: 8px;
        }

        .cursor {
            display: inline-block;
            width: 8px;
            height: 14px;
            background: var(--muted);
            animation: blink 1.1s steps(1) infinite;
        }

        .resp {
            color: var(--red);
            padding-left: 17px;
        }
    }

    @keyframes blink {
        50% {
            opacity: 0;
        }
    }
</style>
