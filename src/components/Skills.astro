---
import Icon from './Icon.astro';
import { info, techSkillGroups, otherSkills, googleSkills } from '../data';
---

<section class="section" id="skills">
    <div class="container">
        <div class="section-head reveal">
            <span class="eyebrow">Skills</span>
            <h2>A stack sharpened <span class="grad">over a decade</span></h2>
        </div>

        <div class="skills-grid">
            <article class="skill-card card reveal">
                <header>
                    <span class="skill-icon"><Icon name={info.ProgrommingSkills.Icon} size={20} /></span>
                    <h3>{info.ProgrommingSkills.Text}</h3>
                    <span class="hint">grouped by the year adopted</span>
                </header>

                <div class="groups">
                    {techSkillGroups.map((group) => (
                        <div class="group">
                            <span class="year">since {group.year}</span>
                            <div class="chips">
                                {group.items.map((item) => <span class="chip">{item}</span>)}
                            </div>
                        </div>
                    ))}
                </div>
            </article>

            <article class="skill-card card reveal" data-delay="1">
                <header>
                    <span class="skill-icon gold"><Icon name={info.PersonalSkills.Icon} size={20} /></span>
                    <h3>{info.PersonalSkills.Text}</h3>
                </header>
                <div class="bars">
                    {otherSkills.map((skill) => (
                        <div class="bar-row">
                            <div class="bar-head">
                                <span>{skill.label}</span>
                                <span class="pct">{skill.value}%</span>
                            </div>
                            <div class="bar-track">
                                <span class="bar-fill" style={`--val:${skill.value}%`}></span>
                            </div>
                        </div>
                    ))}
                </div>
            </article>

            <article class="skill-card card span reveal" data-delay="2">
                <header>
                    <span class="skill-icon green"><Icon name={info.GoogleSkills.Icon} size={20} /></span>
                    <h3>{info.GoogleSkills.Text}</h3>
                </header>
                <div class="bars cols">
                    {googleSkills.map((skill) => (
                        <div class="bar-row">
                            <div class="bar-head">
                                <span>{skill.label}</span>
                                <span class="pct">{skill.value}%</span>
                            </div>
                            <div class="bar-track">
                                <span class="bar-fill alt" style={`--val:${skill.value}%`}></span>
                            </div>
                        </div>
                    ))}
                </div>
            </article>
        </div>
    </div>
</section>

<style lang="scss">
    @use '../styles/tokens';

    .skills-grid {
        display: grid;
        grid-template-columns: 1.25fr 1fr;
        gap: 18px;
        align-items: start;
    }

    .skill-card {
        padding: 28px;
        transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);

        &:hover {
            border-color: var(--line-strong);
            box-shadow: var(--shadow-card), 0 8px 24px -10px var(--accent-glow);
        }

        &.span {
            grid-column: 1 / -1;
        }
    }

    header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 22px;

        h3 {
            font-size: 18px;
            font-weight: 600;
        }

        .hint {
            margin-left: auto;
            font: 500 11px var(--font-mono);
            color: var(--faint);
        }
    }

    .skill-icon {
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        color: var(--blue);
        background: var(--blue-soft);
        border: 1px solid var(--line);

        &.gold {
            color: var(--gold);
            background: var(--gold-soft);
        }

        &.green {
            color: var(--green);
            background: var(--green-soft);
        }
    }

    // ---- Technical: year groups + chips ----
    .groups {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .group {
        .year {
            display: inline-block;
            font: 500 11.5px var(--font-mono);
            color: var(--gold);
            background: var(--gold-soft);
            border: 1px solid var(--line);
            border-radius: var(--radius-pill);
            padding: 2px 10px;
            margin-bottom: 10px;
        }
    }

    .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .chip {
        font: 500 12.5px var(--font-body);
        color: var(--text);
        background: var(--surface-2);
        border: 1px solid var(--line);
        border-radius: var(--radius-pill);
        padding: 6px 13px;
        transition: color 0.2s var(--ease), border-color 0.2s var(--ease),
            background 0.2s var(--ease), transform 0.2s var(--ease);

        &:hover {
            color: #fff;
            background: var(--accent-soft);
            border-color: var(--accent);
            transform: translateY(-2px);
        }
    }

    // ---- Bars ----
    .bars {
        display: flex;
        flex-direction: column;
        gap: 16px;

        &.cols {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px 32px;
        }
    }

    .bar-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 7px;

        span:first-child {
            font-size: 13.5px;
            color: var(--muted);
        }

        .pct {
            font: 500 11.5px var(--font-mono);
            color: var(--faint);
        }
    }

    .bar-track {
        height: 7px;
        border-radius: var(--radius-pill);
        background: var(--surface-2);
        border: 1px solid var(--line);
        overflow: hidden;
    }

    .bar-fill {
        display: block;
        height: 100%;
        width: 0;
        border-radius: inherit;
        background: var(--grad-accent);
        transition: width 1.1s var(--ease);
        transition-delay: 0.15s;

        &.alt {
            // Secondary set bridges the violet accent into the brand blue.
            background: linear-gradient(90deg, var(--accent), var(--blue));
        }
    }

    // .in comes from the reveal observer on the card ancestor.
    :global(.reveal.in) .bar-fill {
        width: var(--val);
    }

    @media (max-width: 900px) {
        .skills-grid {
            grid-template-columns: 1fr;
        }

        .bars.cols {
            grid-template-columns: 1fr;
        }
    }
</style>
