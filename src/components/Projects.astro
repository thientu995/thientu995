---
import { info, normalizeRichHtml } from '../data';
import Icon from './Icon.astro';
---

<section class="section" id="projects">
    <div class="container">
        <div class="section-head reveal">
            <span class="eyebrow">{info.IndividualProjects.Text}</span>
            <h2>Things I've built <span class="grad">on my own</span></h2>
        </div>

        <div class="proj-grid">
            {info.IndividualProjects.Data.map((project, i) => (
                <article class="proj-card card reveal" data-delay={String(i % 2)}>
                    <span class="proj-date">
                        <Icon name="calendar" size={12} />
                        {project.Date}
                    </span>
                    <h3>{project.Text}</h3>
                    <div class="rich" set:html={project.Value.map(normalizeRichHtml).join('\n')} />
                </article>
            ))}
        </div>
    </div>

    <div class="container certs">
        <div class="section-head reveal">
            <span class="eyebrow">{info.Certificate.Text}</span>
            <h2>Credentials that <span class="grad">back it up</span></h2>
        </div>

        <div class="cert-grid">
            {info.Certificate.Data.map((cert, i) => (
                <article class="cert-card card reveal" data-delay={String(i % 3)}>
                    <span class="cert-icon"><Icon name="award" size={19} /></span>
                    <div>
                        <h3>{cert.Text}</h3>
                        <span class="cert-date">{cert.Date}</span>
                        <p>{cert.Value.join(' · ')}</p>
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>

<style lang="scss">
    @use '../styles/tokens';

    // One full-width card per row, matching the Education/Experience sections.
    .proj-grid {
        display: grid;
        gap: 18px;
    }

    .proj-card {
        padding: 24px 26px;
        transition: transform 0.3s var(--ease), border-color 0.3s var(--ease);

        &:hover {
            transform: translateY(-4px);
            border-color: var(--line-strong);
        }

        h3 {
            font-size: 16.5px;
            font-weight: 600;
            line-height: 1.45;
            margin: 12px 0 10px;
        }
    }

    .proj-date {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font: 500 11.5px var(--font-mono);
        color: var(--accent);
        background: var(--accent-soft);
        border: 1px solid var(--line);
        border-radius: var(--radius-pill);
        padding: 3px 11px;
    }

    .certs {
        margin-top: clamp(56px, 8vw, 88px);
    }

    .cert-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .cert-card {
        display: flex;
        gap: 15px;
        padding: 22px 24px;
        align-items: flex-start;

        h3 {
            font-size: 15.5px;
            font-weight: 600;
        }

        p {
            margin-top: 6px;
            color: var(--muted);
            font-size: 13.5px;
            line-height: 1.6;
        }
    }

    .cert-icon {
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        flex: none;
        border-radius: 12px;
        color: var(--gold);
        background: var(--gold-soft);
        border: 1px solid var(--line);
    }

    .cert-date {
        display: block;
        margin-top: 3px;
        font: 500 11.5px var(--font-mono);
        color: var(--faint);
    }

    @media (max-width: 900px) {
        .cert-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
