---
// Inline SVG icon set (Lucide-style strokes). Maps the legacy Font Awesome
// names used by the data files onto this design system's icon language.
interface Props {
    name: string;
    size?: number;
    stroke?: number;
    class?: string;
    style?: string;
    [key: string]: any;
}

const { name, size = 18, stroke = 2, class: cls, style: inlineStyle, ...rest } = Astro.props;

