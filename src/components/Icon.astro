// Font Awesome aliases coming from the legacy data files.
const aliases: Record<string, string> = {
    'map-marker': 'map-pin',
    envelope: 'mail',
    'internet-explorer': 'globe',
    'smile-o': 'smile',
    'product-hunt': 'package',
    support: 'headphones',
    certificate: 'award',
    asterisk: 'sparkles',
    suitcase: 'briefcase',
    'code-fork': 'git-fork',
    html5: 'code',
    desktop: 'monitor',
    'mobile-phone': 'smartphone',
    'puzzle-piece': 'puzzle',
    tachometer: 'gauge',
    slideshare: 'messages',
    'quote-right': 'quote',
};

const key = aliases[name] ?? name;
const path = icons[key] ?? icons.sparkles;
// The Google logo path is a solid fill; everything else is a stroke drawing.
const isFill = key === 'google';
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill={isFill ? 'currentColor' : 'none'}
    stroke={isFill ? 'none' : 'currentColor'}
    stroke-width={isFill ? undefined : stroke}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class={cls}
    style={inlineStyle}
    set:html={path}
    {...rest}
/>
