---
import Icon from './Icon.astro';
import { info, profile } from '../data';

const socials = [
    { icon: 'github', href: profile.github, label: 'GitHub' },
    { icon: 'skype', href: 'skype:thientu995?chat', label: 'Skype' },
    { icon: 'mail', href: `mailto:${profile.email}`, label: 'Email' },
    { icon: 'globe', href: profile.website, label: 'Website' },
];

const chips = ['.NET Core', 'C#', 'TypeScript', 'Angular', 'React', 'Umbraco'];

// Terminal lines - CSS-staggered reveal, no JS needed.
const term = [
    { prompt: true, text: 'whoami' },
    { out: true, text: 'thientu995 — fullstack .net developer' },
    { prompt: true, text: 'cat stack.txt' },
    { out: true, text: '.NET · C# · TypeScript · Angular · React' },
    { prompt: true, text: 'uptime --career' },
    { out: true, text: '9+ years · 500+ projects shipped' },
    { ok: true, text: 'open to new opportunities' },
];
---

<section class="hero" id="hero">
    <div class="container hero-inner">
        <div class="hero-text">
            <span class="hero-badge reveal in">
                <span class="pulse" aria-hidden="true"></span>
                Open to opportunities
            </span>

            <h1 class="reveal in" data-delay="1">
                Nguyễn <span class="grad">Thiên Tứ</span>
            </h1>

            <p class="role reveal in" data-delay="2">
                <span class="seg">{profile.role}</span>
                <span class="seg">{profile.location}</span>
                <span class="seg">coding since 2017</span>
            </p>

            <p class="lead reveal in" data-delay="2">
                {info.CareerObjective.About}
            </p>

            <div class="hero-actions reveal in" data-delay="3">
                <a href="/assets/data/cv.pdf" class="btn btn-primary" download>
                    <Icon name="download" size={16} />
                    Download CV
                </a>
                <a href="#contact" class="btn btn-ghost">
                    <Icon name="send" size={16} />
                    Contact me
                </a>
            </div>

            <div class="hero-social reveal in" data-delay="3">
                {socials.map((s) => (
                    <a
                        href={s.href}
                        aria-label={s.label}
                        target={s.href.startsWith('http') ? '_blank' : undefined}
                        rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    >
                        <Icon name={s.icon} size={17} />
                    </a>
                ))}
            </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
            <div class="profile-card">
                <div class="window-bar">
                    <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
                    <span class="wfile">~/{profile.github.split('/').pop()}/profile</span>
                </div>
                <div class="profile-body">
                    <img
                        src="/assets/images/avatar-profile.jpg"
                        alt=""
                        width="96"
                        height="96"
                        loading="eager"
                    />
                    <div class="who">
                        <strong>{info.Information.FullName}</strong>
                        <span>{profile.role}</span>
                    </div>
                    <div class="chips">
                        {chips.map((c) => <span class="chip">{c}</span>)}
                    </div>
                </div>
            </div>

            <div class="terminal">
                <div class="window-bar">
                    <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
                    <span class="wfile">bash — career.sh</span>
                </div>
                <div class="term-body">
                    {term.map((line, i) => (
                        <div class="cmd" style={`--i:${i}`}>
                            {line.prompt && <span class="prompt">$</span>}
                            {line.ok && <span class="ok">✓</span>}
                            {line.text}
                        </div>
                    ))}
                    <div class="cmd caret" style={`--i:${term.length}`}>
                        <span class="prompt">$</span><span class="cursor"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <a class="scroll-hint" href="#facts" aria-label="Scroll to facts">
        <Icon name="chevron-left" size={16} class="down" />
    </a>
</section>

<style lang="scss">
    @use '../styles/tokens';

    .hero {
        position: relative;
        padding: calc(var(--nav-h) + clamp(48px, 8vh, 96px)) 0 clamp(40px, 6vh, 72px);
        min-height: 92svh;
        display: flex;
        align-items: center;
    }

    .hero-inner {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: clamp(32px, 5vw, 64px);
        align-items: center;
    }

    // ---- Left column ----
    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 16px;
        border-radius: var(--radius-pill);
        background: var(--surface);
        border: 1px solid var(--line);
        backdrop-filter: blur(8px);
        font: 500 13px var(--font-body);
        color: var(--muted);

        .pulse {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--green);
            animation: pulse 2.2s infinite;
        }
    }

    @keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(88, 180, 90, 0.5);
        }

        70% {
            box-shadow: 0 0 0 9px rgba(88, 180, 90, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(88, 180, 90, 0);
        }
    }

    h1 {
        font-size: clamp(42px, 6.4vw, 74px);
        font-weight: 700;
        letter-spacing: -0.035em;
        margin: 22px 0 14px;

        .grad {
            background: var(--grad-brand);
            background-size: 200% 100%;
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            animation: gradflow 8s ease-in-out infinite alternate;
        }
    }

    @keyframes gradflow {
        from {
            background-position: 0% 0;
        }

        to {
            background-position: 100% 0;
        }
    }

    .role {
        display: flex;
        flex-wrap: wrap;
        column-gap: 4px;
        row-gap: 2px;
        font: 500 14px var(--font-mono);
        color: var(--muted);
        margin-bottom: 18px;

        // Each fact stays on one line; wrapping happens between facts only.
        .seg {
            white-space: nowrap;
        }

        .seg + .seg::before {
            content: '·';
            margin: 0 9px 0 5px;
            color: var(--faint);
        }
    }

    .lead {
        color: var(--muted);
        font-size: clamp(15.5px, 1.6vw, 17.5px);
        line-height: 1.75;
        max-width: 560px;
        margin-bottom: 30px;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 26px;
    }

    .hero-social {
        display: inline-flex;
        gap: 10px;

        a {
            display: grid;
            place-items: center;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            color: var(--muted);
            background: var(--surface);
            border: 1px solid var(--line);
            transition: color 0.2s var(--ease), border-color 0.2s var(--ease),
                transform 0.2s var(--ease), background 0.2s var(--ease);

            &:hover {
                color: var(--accent);
                border-color: var(--accent);
                background: var(--accent-soft);
                transform: translateY(-3px);
            }
        }
    }

    // ---- Right column: profile card + terminal ----
    .hero-visual {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .window-bar {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 11px 15px;
        border-bottom: 1px solid var(--line);

        .dot {
            width: 11px;
            height: 11px;
            border-radius: 50%;

            &.r {
                background: var(--red);
            }

            &.y {
                background: var(--gold);
            }

            &.g {
                background: var(--green);
            }
        }

        .wfile {
            margin-left: 8px;
            font: 500 11.5px var(--font-mono);
            color: var(--faint);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
    }

    .profile-card {
        border-radius: var(--r-lg);
        background: var(--surface);
        border: 1px solid var(--line);
        box-shadow: var(--shadow-card);
        overflow: hidden;
    }

    .profile-body {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 22px;

        img {
            width: 76px;
            height: 76px;
            border-radius: 20px;
            object-fit: cover;
            border: 2px solid transparent;
            background:
                linear-gradient(var(--bg-raise), var(--bg-raise)) padding-box,
                var(--grad-brand) border-box;
        }

        .who {
            display: flex;
            flex-direction: column;
            gap: 3px;
            min-width: 0;

            strong {
                font: 700 18px var(--font-display);
                letter-spacing: -0.01em;
            }

            span {
                font: 500 12.5px var(--font-mono);
                color: var(--muted);
            }
        }

        .chips {
            display: none;
        }
    }

    .terminal {
        border-radius: var(--r-lg);
        background: var(--code-bg);
        border: 1px solid var(--line);
        box-shadow: var(--shadow-card);
        backdrop-filter: blur(10px);
    }

    .term-body {
        padding: 18px 20px 20px;
        font: 400 13px/1.9 var(--font-mono);
        min-height: 200px;

        .cmd {
            opacity: 0;
            animation: lineIn 0.01s forwards;
            animation-delay: calc(0.35s + var(--i) * 0.28s);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: var(--muted);
        }

        .prompt {
            color: var(--green);
            margin-right: 9px;
        }

        .ok {
            color: var(--green);
            margin-right: 9px;
        }

        .caret {
            display: flex;
            align-items: center;
        }

        .cursor {
            width: 8px;
            height: 15px;
            background: var(--muted);
            animation: blink 1.1s steps(1) infinite;
        }
    }

    @keyframes lineIn {
        to {
            opacity: 1;
        }
    }

    @keyframes blink {
        50% {
            opacity: 0;
        }
    }

    // ---- Scroll hint ----
    .scroll-hint {
        position: absolute;
        left: 50%;
        bottom: 18px;
        transform: translateX(-50%);
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        color: var(--faint);
        border: 1px solid var(--line);
        transition: color 0.2s var(--ease), border-color 0.2s var(--ease);

        .down {
            transform: rotate(-90deg);
            animation: bob 2s var(--ease) infinite;
        }

        &:hover {
            color: var(--accent);
            border-color: var(--accent);
        }
    }

    @keyframes bob {
        0%,
        100% {
            transform: rotate(-90deg) translateX(0);
        }

        50% {
            transform: rotate(-90deg) translateX(4px);
        }
    }

    // ---- Responsive ----
    @media (max-width: 960px) {
        .hero {
            min-height: 0;
        }

        .hero-inner {
            grid-template-columns: 1fr;
        }

        .hero-visual {
            max-width: 520px;
        }

        .scroll-hint {
            display: none;
        }
    }

    @media (max-width: 480px) {
        .hero-actions .btn {
            flex: 1 1 100%;
        }

        .term-body {
            font-size: 11.5px;
        }
    }
</style>
